@article{PhysRev.47.777,
  abbr              = {Article},
  title             = {Neuroprotective effect of Mauritia flexuosa on a unilateral 6-OHDA-induced Parkinson's disease in rats},
  author            = {Gyr, E., Ramos, D., Muñoz, A., Best, I., Aguilar, L.},
  abstract          = {Introduction: Parkinson's disease (PD) is a neurodegenerative disorder characterized by motor and cognitive impairments, primarily due to the progressive loss of dopaminergic neurons in the substantia nigra. Objectives: To evaluate the neuroprotective effects of Mauritia flexuosa in a unilateral 6-OHDA-induced Parkinson's disease rat model. Methods: Wistar rats were treated with 6-OHDA to induce PD-like symptoms. Treatment groups received Mauritia flexuosa extract or vehicle control. Motor function and dopamine levels were assessed. Results: Mauritia flexuosa treatment significantly improved motor performance and increased dopamine levels compared to control groups. Conclusions: These findings suggest that Mauritia flexuosa has neuroprotective potential in Parkinson's disease models and warrants further investigation for therapeutic applications.},
  journal           = {Revista Colombiana de Ciencias Químico-Farmacéuticas},
  location          = {Colombia},
  volume            = {53},
  issue             = {3},
  pages             = {881--899},
  numpages          = {0},
  year              = {2024},
  html              = {https://revistas.unal.edu.co/index.php/rccquifa/article/view/119217}
}

@article{MoCA2025,
  abbr              = {Article},
  title             = {Normative data of the Spanish version of the Montreal Cognitive Assessment (MoCA) in older individuals from Peru},
  author            = {Bulgarelli, L., Gyr, E., Villanueva, J., Mejía, K., Mejía, C., Paredes, R., Blumen, S.},
  abstract          = {The Montreal Cognitive Assessment (MoCA) has proven to be an effective tool for detecting early dementia in older adults. However, in the Latin American region, there are few standardized normative values. Objective: To standardize the Spanish version of the MoCA for the older population in Lima, Peru, addressing the critical need for culturally and demographically adapted cognitive evaluation tools. Methods: The test was administered to 338 ambulatory and homebound adults aged 60 to 80 (216 women) from three institutions in Lima. Results: Sex was not a predictor of the total scores of MoCA. Age (R²=0.12) and education (R²=0.24) significantly influenced cognitive performance, with education being the strongest predictor. Conclusions: We provided normative data and cutoff scores for older Peruvians, supporting the clinical use of the MoCA in Peru and setting a benchmark for future test standardizations in the region.},
  journal           = {Dementia & Neuropsychologia},
  location          = {Brasil},
  volume            = {19},
  year              = {2025},
  html              = {https://www.demneuropsy.org/wp-content/uploads/articles_xml/1980-5764-DN-19-e20240261/1980-5764-DN-19-e20240261.pdf}
}
